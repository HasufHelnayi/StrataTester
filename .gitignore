# ==============================================================================
# StrataTester - Comprehensive Root .gitignore
# Covering: Python (Backend & SDK), Node/React/Vite (Frontend), OS & Editors
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (NEVER commit credentials)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.template
!.env.sample
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------------------------
# Python (Backend & SDK)
# ------------------------------------------------------------------------------
# Bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.conda/

# Packaging, builds, and distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit tests, Coverage & Testing caches
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.pytest_cache/

# Type checking & Linter caches
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints

# ------------------------------------------------------------------------------
# Node.js & Frontend (React / Vite)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
jspm_packages/
.pnp
.pnp.js

# Build outputs
frontend/dist/
frontend/dist-ssr/
frontend/build/
dist/
dist-ssr/

# Vite & bundler cache
.vite/
.parcel-cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Local Data, Databases, Backtest Exports & Inspection Dumps
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.parquet
# Backtest run output dumps/exports
exports/
results/
*.pkl
*.pickle
inspection/


# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# IDEs and Code Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
*.swp
*.swo
*.swn
.#*
*#
